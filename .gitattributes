# Line endings: store and check out text files with LF on every machine, Windows included,
# so a commit from Windows never shows whole files as changed because of CRLF/LF differences.
# This overrides each developer's core.autocrlf setting.
* text=auto eol=lf

# Windows batch scripts must keep CRLF to run.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never convert line endings or try to show text diffs.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.woff binary
*.woff2 binary
