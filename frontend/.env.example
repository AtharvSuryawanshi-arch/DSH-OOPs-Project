# I-ITSM frontend configuration (all optional in local development).

# The Vite dev server proxies /api and /actuator to this backend.
# VITE_PROXY_TARGET=http://localhost:8080

# Point the UI directly at a backend instead of using the dev proxy.
# Requires the backend CORS allow-list to include the frontend origin.
# VITE_API_BASE_URL=http://localhost:8080
