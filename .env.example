# Copy to .env to override the Docker Compose defaults.
# These values are read by docker compose only. If you change the database
# credentials or port, pass the matching DB_* variables to the backend too.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
# Change this if something else already uses host port 5432.
POSTGRES_PORT=5432

# Backend-side examples (export before `./mvnw spring-boot:run`):
# DB_URL=jdbc:postgresql://localhost:5432/app
# DB_USERNAME=app
# DB_PASSWORD=app
# JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
# APP_SEED_ENABLED=true
